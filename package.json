{
  "name": "xiaoyu",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "description": "小鱼：跑在自己电脑上的 AI 陪伴机器人（QQ + 声音 + 画图 + 唱歌）。路径只有一个来源：src/paths.js。",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/bridge.js",
    "status": "node bin/status.mjs",
    "gui": "node gui/server.mjs",
    "console:build": "npm --prefix gui run build",
    "init": "node src/paths.js --init",
    "check": "node src/paths.js --init --check",
    "boot-check": "node src/bridge.js --check",
    "smoke": "node scripts/self-check.mjs",
    "test:link": "node scripts/test-snowluma-link.mjs",
    "test:life": "node --test tests/life-mechanisms.test.mjs tests/life-integration.test.mjs tests/reality.test.mjs tests/project-workflow.test.mjs",
    "test:pairing": "node scripts/test-pairing.mjs",
    "test:pairing-e2e": "node scripts/test-pairing-e2e.mjs",
    "dsh": "node scripts/dsh-setup.mjs",
    "setup-dsh": "node scripts/setup-dsh.mjs",
    "postinstall": "node scripts/patch-snowluma-sdk.mjs",
    "test:ci": "node --test --test-skip-pattern \"真 bridge\" tests/ && npm run test:pairing-e2e"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.20",
    "@snowluma/sdk": "^1.14.20",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3"
  }
}
